childResult(result, Document, "specifications") :-
    link({{cardKey}}, Document, "base/linkTypes/relatesTo"),
    field(Document, "base/fieldTypes/identifier", "secdeva_document_design-specification").

childResult(result, Document, "specifications") :-
    link(Document, {{cardKey}}, "base/linkTypes/relatesTo"),
    field(Document, "base/fieldTypes/identifier", "secdeva_document_design-specification").

childObject(result, Phase, "designPhase") :-
    secdeva_closestProject({{cardKey}}, Project),
