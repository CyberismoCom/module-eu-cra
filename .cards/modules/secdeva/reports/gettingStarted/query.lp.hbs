% Find the first tasks

% tick the checkbox for the following assessment values:
secdeva_tickCheckbox("ok").
secdeva_tickCheckbox("notApplicable").

resultField(result, "project", Project, "shortText") :-
  secdeva_closestProject({{cardKey}}, Project).

resultField(result, "projectCheckbox", "[ ]", "shortText") :-
  secdeva_closestProject({{cardKey}}, Project),
  not field(Project, "workflowStateCategory", "closed").

resultField(result, "projectCheckbox", "[ ]", "shortText") :-
  secdeva_closestProject({{cardKey}}, Project),
  field(Project, "workflowStateCategory", "closed"),
  base_policyCheckFailure(Project, _, _, _).

resultField(result, "projectCheckbox", "[x]", "shortText") :-
  secdeva_closestProject({{cardKey}}, Project),
  field(Project, "workflowStateCategory", "closed"),
  not base_policyCheckFailure(Project, _, _, _).

