selectAll.
select(2, "requirements", "policyChecks").

result(result).

resultField(result, "register", Register, "shortText") :-
  secdeva_closestProject({{cardKey}}, Project),
  secdeva_closestProject(Register, Project),
  field(Register, "base/fieldTypes/identifier", "secdeva_register_security-requirements").
resultField(result, "registerStatus", Status, "shortText") :-
  secdeva_closestProject({{cardKey}}, Project),
  secdeva_closestProject(Register, Project),
  field(Register, "base/fieldTypes/identifier", "secdeva_register_security-requirements"),
  field(Register, "workflowState", Status).

childResult(result, Requirement, "requirements") :-
  secdeva_registerMember(Requirement, Register),
  secdeva_closestProject(Register, Project),
  secdeva_closestProject({{cardKey}}, Project),
  secdeva_closestProject(Requirement, Project),
  field(Register, "base/fieldTypes/identifier", "secdeva_register_security-requirements").

childResult(Requirement, Risk, "risks") :-
  childResult(result, Requirement, "requirements"),
  link(Requirement, Risk, "ismsa/linkTypes/mitigates").

childResult(Requirement, Asset, "assets") :-
  childResult(result, Requirement, "requirements"),
  link(Requirement, Asset, "secdeva/linkTypes/appliesTo").

orderBy("rank", "ASC").