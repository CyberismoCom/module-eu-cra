% ----------------------------------------------------------------------------
% Reviews
% ----------------------------------------------------------------------------

childResult(result, Card, "reviewTasks") :-
    card(Card),
    parent(Card, {{cardKey}}),
    field(Card, "cardType", "base/cardTypes/reviewTask").

% ----------------------------------------------------------------------------
% Ordering
% ----------------------------------------------------------------------------

order(2, "parentDataflows", 1, "sourceTitle", "ASC").
order(2, "parentDataflows", 2, "description", "ASC").

order(2, "dataflows", 1, "sourceTitle", "ASC").
order(2, "dataflows", 2, "description", "ASC").

order(3, "trustBoundaries", 1, "title", "ASC").

order(2, "securityContextDocuments", 1, "title", "ASC").

order(2, "risks", 1, "rank", "ASC").
order(2, "issues", 1, "rank", "ASC").
order(2, "requirements", 1, "rank", "ASC").
order(2, "technologies", 1, "rank", "ASC").
order(2, "decisions", 1, "rank", "ASC").
order(2, "specifications", 1, "rank", "ASC").

order(2, "reviewTasks", 1, "rank", "ASC").
