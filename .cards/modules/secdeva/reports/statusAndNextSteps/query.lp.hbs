selectAll.

result(result).

% Find the project card and the phase cards

childObject(result, Project, "project") :-
  secdeva_closestProject({{cardKey}}, Project).

childObject(result, Card, "foundationPhase") :-
  secdeva_closestProject(Card, Project),
  secdeva_closestProject({{cardKey}}, Project),
  field(Card, "base/fieldTypes/identifier", "secdeva_phase_foundation").

