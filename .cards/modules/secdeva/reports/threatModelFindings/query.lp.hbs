selectAll.

result(result).

threatModelEntity(Card) :-
  ancestor(Card, {{cardKey}}).

threatModelEntity({{cardKey}}).

resultField(result, "issueRegister", Register, "shortText") :-
  field(Register, "base/fieldTypes/identifier", "secdeva_register_security-issues"),
  secdeva_closestProject({{cardKey}}, Project),
  secdeva_closestProject(Register, Project).

resultField(result, "riskRegister", Register, "shortText") :-
  field(Register, "base/fieldTypes/identifier", "secdeva_register_risks"),
  secdeva_closestProject({{cardKey}}, Project),
  secdeva_closestProject(Register, Project).

childResult(result, Risk, "risks") :-
  field(Risk, "cardType", "ismsa/cardTypes/risk"),
  link(AffectedCard, Risk, "ismsa/linkTypes/presentsRisk"),
  secdeva_closestProject(Risk, Project),
  secdeva_closestProject({{cardKey}}, Project).

childResult(result, Issue, "securityIssues") :-
  field(Issue, "cardType", "secdeva/cardTypes/securityIssue"),
  link(AffectedCard, Issue, "ismsa/linkTypes/presentsRisk"),
  threatModelEntity(AffectedCard).

% Wrap the affected card in a (Card, AffectedCard) tuple key so that it can
% never become a parent of Card in turn: childResult cycles make the result
% tree unbounded and hang grounding.
childResult(Card, (Card, AffectedCard), "affectedCard") :-
   childResult(result, Card, _),
   link(AffectedCard, Card, "ismsa/linkTypes/presentsRisk").

resultField((Card, AffectedCard), "key", AffectedCard, "shortText") :-
   childResult(Card, (Card, AffectedCard), "affectedCard").

resultField((Card, AffectedCard), "title", Title, "shortText") :-
   childResult(Card, (Card, AffectedCard), "affectedCard"),
   field(AffectedCard, "title", Title).

orderBy("title", "ASC").